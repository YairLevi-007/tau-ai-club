# Copy to .env.local for local dev. Never commit real values.
# Vercel: set these per environment (Production -> prod project, Preview + Development -> dev project).

# Supabase (Project Settings -> API). The publishable key is safe in the browser; RLS protects data.
# Log-in is email + 6-digit code (HANDOVER.md §3 G). The dormant Google path needs nothing
# here either: its client ID/secret would live only in Supabase -> Providers -> Google.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-DEV-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Server-only secret key (Project Settings -> API Keys -> Secret). Used ONLY by the log-in route to
# check that an email is on the club list before Supabase sends a code (HANDOVER.md runbook G).
# Every page query still runs as the visitor under RLS. Never add a NEXT_PUBLIC_ prefix.
# Unset = the before_user_created auth hook is the only gate (it still blocks unlisted emails).
# SUPABASE_SECRET_KEY=sb_secret_xxx

# Canonical origin, no trailing slash. Production (Vercel): https://tauaiclub.com. Local: http://localhost:3000.
# Unset on Preview, where Vercel's production domain is used for canonical links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Members/admin area switch. `true` only after email-code log-in is set up in Supabase
# (HANDOVER.md §3 G: SMTP, OTP templates, the before_user_created hook). Off (unset) = sign-in hidden, members/admin routes show "coming soon".
# DATA_SOURCE=seed always keeps it off.
# AUTH_ENABLED=true

# Site emails (today: the answer to an initiative proposal), sent through the club's Gmail.
# The owner sets these in Vercel only (server-side, never NEXT_PUBLIC_*). Unset = no email is sent
# and nothing breaks; members still see the answer on the site. SMTP_APP_PASSWORD is a Google
# "app password" for SMTP_USER, not the account password. Never commit real values.
# SMTP_USER=
# SMTP_APP_PASSWORD=

# TEMPORARY until Supabase; remove after migration. `seed` serves the season from
# src/lib/data/fixtures.json even in production (see HANDOVER.md, B1). Unset = Supabase.
# DATA_SOURCE=seed

# --- Local/QA only (ignored when VERCEL_ENV=production) ---
# Use src/lib/data/fixtures.json (generated from supabase/seed.sql) when Supabase isn't configured.
# USE_FIXTURES=1
# Pin "now" for Next-event logic, e.g. 2026-11-18T19:59:00+02:00
# DEBUG_NOW=
